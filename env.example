# Copie para .env.local (não versionado) — só desenvolvimento.
# Instaladores oficiais embutem env.sandbox / env.production via channel.json (CI).

# Dev típico Leo: front local + API de TESTE na VPS (não há backend em :8080 por padrão).
# DELIDESK_API_URL=https://delivai-test-delivai-backend-sandbox.rwysej.easypanel.host
# Só use localhost:8080 se você subir bootRun local.
#
# Auto-update (só build empacotado): se omitido, bake gera a partir da API:
# DELIDESK_UPDATE_FEED_URL=https://…/webhook/public/delidesk-update/sandbox

# URL Autorizar (abre no navegador do sistema) — MESMA origem do painel
# DELIDESK_AUTH_URL=http://localhost:3000/autorizar
# DELIDESK_PANEL_URL=http://localhost:3000/dashboard/orders
# DELIDESK_CHAT_URL=http://localhost:3000/dashboard/orders
#
# Fluxo: Entrar → navegador /autorizar → delidesk:// → tokens + panel_sso_code
# → BrowserView carrega /delidesk-sso → Pedidos/Conversas já logados.

# 0 = OAuth real; 1 = força mock; omitido = mock só em unpackaged
# DELIDESK_AUTH_MOCK=0

# --- Checklist E2E ---
# 1. BE (V22+V23) + front (/autorizar + /delidesk-sso)
# 2. DELIDESK_AUTH_MOCK=0 + API/AUTH/PANEL mesma origem
# 3. Entrar → Autorizar no navegador → seed do painel
# 4. Aba Pedidos já logada → engrenagem → Salvar impressora
# 5. Pedido imprime via print_jobs
